{
  "name": "gladys-aircraft",
  "version": "0.1.1",
  "private": true,
  "description": "Gladys Assistant external integration for aircraft flying over your home (adsb.lol, adsb.fi, your own ADS-B receiver or OpenSky): closest flight, altitude and heading, an \"aircraft overhead\" scene trigger and a dashboard widget. Unofficial.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LM1LC3N7/gladys-aircraft.git"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0"
}
